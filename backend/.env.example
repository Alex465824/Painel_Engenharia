# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA commitar o arquivo ".env" com credenciais reais no controle de versao.

# --- Painel ---
# Horas que o retrato das obras vale antes de ser refeito sozinho na subida do servidor
CACHE_TTL_HORAS=6
# Teto de chamadas simultaneas ao Prevision (a API nao documenta limite de taxa)
PREVISION_MAX_SIMULTANEAS=8

# --- Sistema Prevision (API REST, token Bearer) ---
PREVISION_API_BASE_URL=https://api.prevision.com.br
PREVISION_API_KEY=

# --- Sistema Mega (Oracle, acesso externo via database link) ---
MEGA_DB_HOST=
MEGA_DB_PORT=1521
MEGA_DB_SERVICE_NAME=
MEGA_DB_USER=
MEGA_DB_PASSWORD=
MEGA_DB_SCHEMA=
MEGA_DB_LINK=
# Pasta de um Oracle Instant Client (modo thick). Sem isso, o logon do database link falha
# com ORA-28267 no modo thin padrao do driver oracledb - baixe em
# https://www.oracle.com/database/technologies/instant-client/downloads.html
MEGA_ORACLE_CLIENT_DIR=

# --- Planilhas internas (histograma de obras, controle de consumo) ---
PLANILHAS_PROJECAO_DIR=../planilhas
